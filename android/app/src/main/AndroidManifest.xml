<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- flutter_local_notifications: receivers required for scheduled
             notifications to survive a device reboot and to actually fire
             at their scheduled time. -->
        <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
        <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
    </application>

    <!-- flutter_local_notifications: RECEIVE_BOOT_COMPLETED lets the boot
         receiver above reschedule alarms after a reboot. SCHEDULE_EXACT_ALARM
         is the Android 12+ (API 31+) permission requested at runtime via
         AndroidFlutterLocalNotificationsPlugin.requestExactAlarmsPermission()
         — needed for zonedSchedule's exactAllowWhileIdle mode used for
         task-start alerts. POST_NOTIFICATIONS is Android 13+ (API 33+); the
         plugin declares it itself, listed here for clarity. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- speech_to_text: RECORD_AUDIO for Quick Capture's voice dictation
         mic button. Requested at runtime, lazily on first tap — see
         quick_capture_sheet.dart. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Slack morning-summary background task: the direct device-to-Slack
         HTTP POST (`http` package, `slack_summary_service.dart`) needs
         real network access. `http`/`workmanager` are pure-Dart/self-
         merging plugins that don't declare this themselves — unlike
         RECEIVE_BOOT_COMPLETED/SCHEDULE_EXACT_ALARM above, a plain
         package-level Internet permission isn't runtime-requested; it's
         install-time only. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- device_calendar: read/write access to the device's own calendars —
         see CONSTITUTION.md's "Calendar" section. Requested at runtime,
         lazily on first use of either Calendar feature (READ + WRITE
         requested together via requestPermissions(), even though Feature 1
         only reads — the plugin's own permission API doesn't separate the
         two). Taken directly from the plugin's own README, not guessed. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
